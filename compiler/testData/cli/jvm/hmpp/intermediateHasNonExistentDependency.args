$TESTDATA_DIR$/src/jvmDependency.kt
-d
$TEMP_DIR$/dependency/dep.jar
---
$TESTDATA_DIR$/src/accessingJdkField.kt
-Xmulti-platform
-Xseparate-kmp-compilation
-Xfragments=common
-Xfragments=intermediate
-Xfragments=platform

-Xfragment-refines=platform\:intermediate
-Xfragment-refines=intermediate\:common

-Xfragment-sources=platform\:$TESTDATA_DIR$/src/accessingJdkField.kt

-Xfragment-dependency=common\:$STDLIB_COMMON_PATH$
-Xfragment-dependency=intermediate\:$TESTDATA_DIR$\nonExistent\

-d
$TEMP_DIR$/out/
