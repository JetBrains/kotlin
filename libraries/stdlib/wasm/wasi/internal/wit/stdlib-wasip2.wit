package kotlin-stdlib:wasip2@2.5.0;

/*
world wasip2 {
    //import wasi:io/streams@0.2.12;
    //import wasi:random/random@0.2.12;
    //import wasi:clocks/monotonic-clock@0.2.12;
    //import wasi:clocks/wall-clock@0.2.12;

    // TODO decide between these, then commit one of the generated source sets

    include wasi:io/imports@0.2.12;
    include wasi:random/imports@0.2.12;
    include wasi:clocks/imports@0.2.12;
    // TODO is this necessary?
    include wasi:cli/imports@0.2.12;

    // TODO need a solution to "sometimes" export wasi:cli/run, important factors:
    // 1. we don't want to pass this export to wit-bindgen, because the compiler generates the implementation by itself
    // 2. if it's a library, we don't want to export it
    export wasi:cli/run@0.2.12;
}

SEE BELOW
*/

// ONLY imports, exactly what the standard library needs to supply its functionality.
world wasip2-imports {
    include wasi:io/imports@0.2.12;
    include wasi:random/imports@0.2.12;
    include wasi:clocks/imports@0.2.12;
    include wasi:cli/imports@0.2.12;
}

// NOTE: Duplicated imports between the standard library and user WIT are handled fine.
//       This means that the only possible conflict between this WIT and the user WIT is the cli/run export.

// For cases where the run function should be exported as well, typically when there is a main function (which will automatically be transformed to wasi:cli/run by the compiler)
world wasip2-run-export {
    export wasi:cli/run@0.2.12;
}

// At the moment, this is equivalent to just the imports
world wasip2-bindgen {
    include wasip2-imports;
}
