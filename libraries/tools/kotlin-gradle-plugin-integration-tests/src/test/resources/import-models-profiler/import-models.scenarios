# gradle-profiler scenarios for the task-backed Kotlin import models POC.
# See README.md next to this file for how to generate the profiled project and run them (`run-profiler.sh`).
#
# Every scenario performs the same Tooling API build action that requests all Kotlin import models of every project
# of the build sequentially, project by project - the equivalent of an IDE sync (the IntelliJ IDEA counterpart,
# `KotlinImportModelsProvider`, fetches the models the same way).
#
#   *_baseline     - models are computed inside `KotlinModelBuilder` on every invocation: the Kotlin Gradle plugin of the
#                    parent commit of this POC, taken from the baseline Maven repository via `-PkotlinBaseline`
#                    (see README.md and generate-project.sh)
#   *_task_backed  - `generateKotlinImportModels` runs first (a configuration-cache-friendly task), the model builder
#                    only reads the produced `.pb` files
#
# For model-building invocations Gradle enables the configuration cache only together with Isolated Projects,
# hence the `_ip` / `_no_ip` pairs. `--isolated-projects` requires Gradle 9.7+; on older versions use
# `-Dorg.gradle.unsafe.isolated-projects=true` instead. The `tasks_only_*` / `sync_only_*` scenarios at the end run
# the task and the sync as two separate invocations to show what that restriction costs.
#
# The `*_change_*` scenarios refer to files of the project generated by `generate-project.sh`.

default-scenarios = ["warm_baseline_ip", "warm_task_backed_ip", "warm_baseline_no_ip", "warm_task_backed_no_ip"]

action = "org.jetbrains.kotlin.gradle.KotlinImportModelsAllProjectsBuildAction"
baseline-ip-args = ["--configuration-cache", "--isolated-projects", "-PkotlinBaseline"]
baseline-no-ip-args = ["-PkotlinBaseline"]
task-backed-ip-args = ["--configuration-cache", "--isolated-projects"]
task-backed-no-ip-args = ["--configuration-cache"]

# --- Warm: nothing changes between invocations -------------------------------------------------------------------------

warm_baseline_ip {
  title = "baseline, CC + IP, no change"
  tooling-api { action = ${action} }
  gradle-args = ${baseline-ip-args}
}

warm_task_backed_ip {
  title = "task-backed models, CC + IP, no change"
  tooling-api { action = ${action} }
  tasks = ["generateKotlinImportModels"]
  gradle-args = ${task-backed-ip-args}
}

warm_baseline_no_ip {
  title = "baseline, no CC/IP, no change"
  tooling-api { action = ${action} }
  gradle-args = ${baseline-no-ip-args}
}

warm_task_backed_no_ip {
  title = "task-backed models, CC without IP, no change"
  tooling-api { action = ${action} }
  tasks = ["generateKotlinImportModels"]
  gradle-args = ${task-backed-no-ip-args}
}

# --- Source change: CC stays valid, model inputs stay identical ---------------------------------------------------------

source_change_baseline_ip {
  title = "baseline, CC + IP, source change"
  tooling-api { action = ${action} }
  gradle-args = ${baseline-ip-args}
  apply-abi-change-to = "jvm-1/src/main/kotlin/Jvm1.kt"
}

source_change_task_backed_ip {
  title = "task-backed models, CC + IP, source change"
  tooling-api { action = ${action} }
  tasks = ["generateKotlinImportModels"]
  gradle-args = ${task-backed-ip-args}
  apply-abi-change-to = "jvm-1/src/main/kotlin/Jvm1.kt"
}

# --- Build script change: CC invalidated, worst case for the task-backed variant ---------------------------------------

script_change_baseline_ip {
  title = "baseline, CC + IP, build script change"
  tooling-api { action = ${action} }
  gradle-args = ${baseline-ip-args}
  apply-build-script-change-to = "jvm-1/build.gradle.kts"
}

script_change_task_backed_ip {
  title = "task-backed models, CC + IP, build script change"
  tooling-api { action = ${action} }
  tasks = ["generateKotlinImportModels"]
  gradle-args = ${task-backed-ip-args}
  apply-build-script-change-to = "jvm-1/build.gradle.kts"
}

# --- Task and sync as separate invocations, no IP ----------------------------------------------------------------------
#
# The same model computation, once as a plain task invocation and once as a model request:
#
#   tasks_only_no_cc  - `generateKotlinImportModels` without the CC: full configuration + model computation, tasks UP-TO-DATE
#   tasks_only_cc     - the same with `--configuration-cache`: a CC hit even without Isolated Projects ("tasks only" CC
#                       mode) - no project is configured, the models are not recomputed. This is what a sync would cost
#                       if Gradle applied the CC to model-building invocations without IP.
#   sync_only_*       - the build action alone, the `.pb` files already exist (they are regenerated by an unmeasured
#                       cleanup build before every measured build): the model builder only reads files, yet the
#                       invocation configures every project because Gradle disables the CC for model requests without IP.

tasks_only_no_cc {
  title = "generateKotlinImportModels only, no CC, no change"
  tasks = ["generateKotlinImportModels"]
}

tasks_only_cc {
  title = "generateKotlinImportModels only, CC without IP, no change"
  tasks = ["generateKotlinImportModels"]
  gradle-args = ["--configuration-cache"]
}

sync_only_task_backed_no_ip {
  title = "task-backed sync only (outputs already generated), CC without IP, no change"
  tooling-api { action = ${action} }
  cleanup-tasks = ["generateKotlinImportModels"]
  gradle-args = ${task-backed-no-ip-args}
}
