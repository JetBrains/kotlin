$TESTDATA_DIR$/warningSuppression.kt
-d
$TEMP_DIR$
-Xrender-internal-diagnostic-names
-Xwarning-level=CONFLICTING_PROJECTION\:disabled
-Xwarning-level=UNCHECKED_CAST,CONFLICTING_PROJECTION\:disabled
-Xwarning-level=NON_EXISTING_DIAGNOSTIC\:disabled
-Xwarning-level=NON_EXISTING_DIAGNOSTIC,UNCHECKED_CAST\:disabled
-Xwarning-level="UNCHECKED_CAST"\:disabled
-Xwarning-level=UNCHECKED_CAST\:disabled
-Xwarning-level=\:disabled
-Xwarning-level=null\:disabled
-Xwarning-level=USELESS_.+\:disabled
