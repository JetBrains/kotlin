$TESTDATA_DIR$/src/classShadowedByEarlierFragmentDependency_libA.kt
-d
$TEMP_DIR$/libA/
---
$TESTDATA_DIR$/src/classShadowedByEarlierFragmentDependency_libB.kt
-d
$TEMP_DIR$/libB/
---
$TESTDATA_DIR$/src/classShadowedByEarlierFragmentDependency_common.kt
$TESTDATA_DIR$/src/classShadowedByEarlierFragmentDependency_platform.kt
-Xmulti-platform
-Xseparate-kmp-compilation
-Xfragments=common
-Xfragments=platform
-Xfragment-sources=common\:$TESTDATA_DIR$/src/classShadowedByEarlierFragmentDependency_common.kt
-Xfragment-sources=platform\:$TESTDATA_DIR$/src/classShadowedByEarlierFragmentDependency_platform.kt
-Xfragment-refines=platform\:common
-Xfragment-dependency=common\:$TEMP_DIR$/libB/
-cp
$TEMP_DIR$/libA/:$TEMP_DIR$/libB/
-d
$TEMP_DIR$/out/