<?xml version="1.0" encoding="UTF-8"?>
<!--
  Restricts ProGuard output to warnings and errors: info-level progress messages
  contain machine-specific absolute paths and would break the golden file check.
-->
<Configuration status="error">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%m%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="warn">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
