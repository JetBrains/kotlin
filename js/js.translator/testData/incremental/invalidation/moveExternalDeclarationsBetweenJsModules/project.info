IGNORE_PER_FILE: true
// Per-class and per-file place artifacts in module subdirectories (js/lib1/...),
// so the relative @file:JsModule("./js-module-a.mjs") path does not resolve.
IGNORE_PER_CLASS: true

MODULES: lib1, lib2, main

STEP 0:
    libs: lib1, lib2, main
    dirty js modules: lib1, lib2, main
STEP 1..2:
    libs: lib1, lib2, main
    dirty js modules: lib1
STEP 3..5:
    libs: lib1, lib2, main
    dirty js modules: lib1, lib2
STEP 6:
    libs: lib1, lib2, main
    dirty js modules: lib2
