# gradle-profiler scenarios for the task-backed Kotlin import models POC.
# See README.md next to this file for how to generate the profiled project and run them (`run-profiler.sh`).
#
# Isolated Projects is disabled and `--configuration-cache` is enabled in every scenario. Three variants of serving
# the models to an IDE, each measured with no change, a source change and a build script change between builds:
#
#   *_baseline    - the sync alone; the models are computed inside `KotlinModelBuilder` on every request. This is the
#                   Kotlin Gradle plugin of the parent commit of the POC, taken from the baseline Maven repository via
#                   `-PkotlinBaseline` (see README.md and generate-project.sh).
#   *_for_tasks   - the sync with `tasks = ["generateKotlinImportModels"]` (`BuildActionExecuter.forTasks`): one
#                   invocation that runs the task first, then the model builder reads the produced `.pb` files.
#   *_task        - `generateKotlinImportModels` alone (a plain task invocation).
#   *_sync        - the sync alone with the `.pb` files already generated (an unmeasured cleanup build regenerates them
#                   before every measured build). `*_task` + `*_sync` is the "separate invocations" variant.
#
# The "sync" is the Tooling API build action `KotlinImportModelsAllProjectsBuildAction`: it requests all Kotlin import
# models of every project sequentially, project by project, the way the IntelliJ IDEA counterpart
# (`KotlinImportModelsProvider`) does. The `*_change_*` scenarios refer to files of the project generated by
# `generate-project.sh`.

default-scenarios = [
  "no_change_baseline", "no_change_for_tasks", "no_change_task", "no_change_sync",
  "source_change_baseline", "source_change_for_tasks", "source_change_task", "source_change_sync",
  "script_change_baseline", "script_change_for_tasks", "script_change_task", "script_change_sync"
]

action = "org.jetbrains.kotlin.gradle.KotlinImportModelsAllProjectsBuildAction"
baseline-args = ["--configuration-cache", "-PkotlinBaseline"]
task-backed-args = ["--configuration-cache"]
source-file = "jvm-1/src/main/kotlin/Jvm1.kt"
build-script = "jvm-1/build.gradle.kts"

# --- No change between builds -------------------------------------------------------------------------------------------

no_change_baseline {
  title = "baseline | no change"
  tooling-api { action = ${action} }
  gradle-args = ${baseline-args}
}

no_change_for_tasks {
  title = "task via forTasks | no change"
  tooling-api { action = ${action} }
  tasks = ["generateKotlinImportModels"]
  gradle-args = ${task-backed-args}
}

no_change_task {
  title = "separate: task only | no change"
  tasks = ["generateKotlinImportModels"]
  gradle-args = ${task-backed-args}
}

no_change_sync {
  title = "separate: sync only | no change"
  tooling-api { action = ${action} }
  cleanup-tasks = ["generateKotlinImportModels"]
  gradle-args = ${task-backed-args}
}

# --- Source change: not a configuration input, not a task input -------------------------------------------------------

source_change_baseline {
  title = "baseline | source change"
  tooling-api { action = ${action} }
  gradle-args = ${baseline-args}
  apply-abi-change-to = ${source-file}
}

source_change_for_tasks {
  title = "task via forTasks | source change"
  tooling-api { action = ${action} }
  tasks = ["generateKotlinImportModels"]
  gradle-args = ${task-backed-args}
  apply-abi-change-to = ${source-file}
}

source_change_task {
  title = "separate: task only | source change"
  tasks = ["generateKotlinImportModels"]
  gradle-args = ${task-backed-args}
  apply-abi-change-to = ${source-file}
}

source_change_sync {
  title = "separate: sync only | source change"
  tooling-api { action = ${action} }
  cleanup-tasks = ["generateKotlinImportModels"]
  gradle-args = ${task-backed-args}
  apply-abi-change-to = ${source-file}
}

# --- Build script change: invalidates the configuration cache entry ---------------------------------------------------

script_change_baseline {
  title = "baseline | build script change"
  tooling-api { action = ${action} }
  gradle-args = ${baseline-args}
  apply-build-script-change-to = ${build-script}
}

script_change_for_tasks {
  title = "task via forTasks | build script change"
  tooling-api { action = ${action} }
  tasks = ["generateKotlinImportModels"]
  gradle-args = ${task-backed-args}
  apply-build-script-change-to = ${build-script}
}

script_change_task {
  title = "separate: task only | build script change"
  tasks = ["generateKotlinImportModels"]
  gradle-args = ${task-backed-args}
  apply-build-script-change-to = ${build-script}
}

script_change_sync {
  title = "separate: sync only | build script change"
  tooling-api { action = ${action} }
  cleanup-tasks = ["generateKotlinImportModels"]
  gradle-args = ${task-backed-args}
  apply-build-script-change-to = ${build-script}
}
